<?xml version="1.0" encoding="utf-8"?>
<!--
    Registers the "alternative view" key as a real game input action, so it appears in
    Options -> Key Bindings and can be remapped.

    ⚠️ EventType="All" is what makes hold-to-view possible: the engine then reports START on
    key-down and FINISH on key-up instead of a single press.
    ⚠️ KEY_TAB, a regular key, NOT a modifier: the gesture recorder treats a modifier as the
    start of a combination, so a player who rebinds away from Shift could never record plain
    Shift again.
    ⚠️ These tables live in the FRONTEND/config database. This file must be loaded from a
    scope="shell" action group only - in scope="game" it fails with 'no such table:
    InputActions' and rolls back that group's entire UpdateDatabase action.
    ⚠️ <Replace> rather than <Row>: idempotent, so re-applying the mod cannot fail.
-->
<Database>
    <InputActions>
        <Replace ActionId="najane-alternative-view"
                 DeviceType="Keyboard"
                 Name="LOC_INPUT_NAJANE_ALTERNATIVE_VIEW"
                 Description="LOC_INPUT_NAJANE_ALTERNATIVE_VIEW_HELP"
                 EventType="All" />
    </InputActions>
    <InputActionDefaultGestures>
        <Replace ActionId="najane-alternative-view" Index="0"
                 GestureType="KBMouse" GestureData="KEY_TAB" />
    </InputActionDefaultGestures>
    <InputContextConstraints>
        <Replace ActionId="najane-alternative-view" ContextId="World" />
        <Replace ActionId="najane-alternative-view" ContextId="Unit" />
    </InputContextConstraints>
</Database>
