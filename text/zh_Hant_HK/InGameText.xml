<?xml version="1.0" encoding="utf-8"?>
<Database>
    <LocalizedText>
        <Row Tag="LOC_NAJANE_SPECIALISTS_COMMON_HEADER" Language="zh_Hant_HK">
            <Text>專家共同產量</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_ALWAYS_NEGATIVES" Language="zh_Hant_HK">
            <Text>永遠顯示負數產量</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_ALWAYS_NEGATIVES_DESCRIPTION" Language="zh_Hant_HK">
            <Text>在所有地塊上顯示負數差異。關閉時只在游標所指的地塊上顯示。</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_ORIGINAL_DEFAULT" Language="zh_Hant_HK">
            <Text>預設顯示原本產量</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_ORIGINAL_DEFAULT_DESCRIPTION" Language="zh_Hant_HK">
            <Text>保持遊戲原本的顯示，只在按住 Shift 時顯示共同產量檢視。關閉時模組檢視為預設，按 Shift 顯示原本檢視。</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_NO_NEGATIVE_COMMON" Language="zh_Hant_HK">
            <Text>不合併負數產量</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_NO_NEGATIVE_COMMON_DESCRIPTION" Language="zh_Hant_HK">
            <Text>在地圖上將維護費用排除於共同數值之外，讓每個地塊繼續顯示完整的負數產量而非只顯示差異。面板中仍會列出。在顯示完整數值的地方（游標所指的地塊），同一種產出的收益與維護費也會分開顯示，而不會相加。</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_ONLY_NONZERO" Language="zh_Hant_HK">
            <Text>只顯示具有共同數值的產量</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_ONLY_NONZERO_DESCRIPTION" Language="zh_Hant_HK">
            <Text>在面板中隱藏沒有共同數值的產量類型，只保留專家實際影響的部分。</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_FULL_ON_HOVER" Language="zh_Hant_HK">
            <Text>游標停留時顯示全部</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_FULL_ON_HOVER_DESCRIPTION" Language="zh_Hant_HK">
            <Text>將游標停留在地塊上時，顯示該地塊的完整產量，而非與共同值的差異。同一種產出的收益與維護費會相加，因此每種產出只顯示一次。僅影響游標所指的地塊。</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_NO_POSITIVE_COMMON" Language="zh_Hant_HK">
            <Text>不合併正數產量</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_NO_POSITIVE_COMMON_DESCRIPTION" Language="zh_Hant_HK">
            <Text>在地圖上將收益排除於共同數值之外，讓每個地塊即使處處相同也顯示完整的正數產量。面板中仍會列出。</Text>
        </Row>
        <Row Tag="LOC_NAJANE_SPECIALISTS_KEY_TO_ORIGINAL" Language="zh_Hant_HK">
            <Text>{1_Key} &#8594; 預設檢視</Text>
        </Row>
        <Row Tag="LOC_NAJANE_SPECIALISTS_KEY_TO_DIFF" Language="zh_Hant_HK">
            <Text>{1_Key} &#8594; 產量差異</Text>
        </Row>
        <Row Tag="LOC_NAJANE_SPECIALISTS_KEY_FALLBACK" Language="zh_Hant_HK">
            <Text>備用檢視按鍵</Text>
        </Row>
        <Row Tag="LOC_INPUT_NAJANE_ALTERNATIVE_VIEW" Language="zh_Hant_HK">
            <Text>Better Specialists UI：備用檢視</Text>
        </Row>
        <Row Tag="LOC_INPUT_NAJANE_ALTERNATIVE_VIEW_HELP" Language="zh_Hant_HK">
            <Text>按住可在共同產量檢視與遊戲原本顯示之間切換。</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_FOOD" Language="zh_Hant_HK">
            <Text>僅顯示食物最高的地塊</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_PRODUCTION" Language="zh_Hant_HK">
            <Text>僅顯示生產力最高的地塊</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_GOLD" Language="zh_Hant_HK">
            <Text>僅顯示金幣最高的地塊</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_SCIENCE" Language="zh_Hant_HK">
            <Text>僅顯示科技值最高的地塊</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_CULTURE" Language="zh_Hant_HK">
            <Text>僅顯示文化值最高的地塊</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_HAPPINESS" Language="zh_Hant_HK">
            <Text>僅顯示幸福感最高的地塊</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_INFLUENCE" Language="zh_Hant_HK">
            <Text>僅顯示影響力最高的地塊</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_NAJANE_HIGHEST_ONLY_DESCRIPTION" Language="zh_Hant_HK">
            <Text>只顯示安置專家後該產出最高的地塊，並隱藏其他地塊上的數字。數值相同的地塊會全部顯示。可以同時開啟多個：只要在任一項中勝出，該地塊就會顯示。游標所指的地塊始終顯示數字。</Text>
        </Row>

        <Row Tag="LOC_OPTIONS_GROUP_NAJANE_MODS_SPECIALISTS" Language="zh_Hant_HK">
            <Text>Najane 模組: 專家</Text>
        </Row>
        <Row Tag="LOC_OPTIONS_GROUP_NAJANE_MODS_YIELDS" Language="zh_Hant_HK">
            <Text>Najane 模組: 專家產量</Text>
        </Row>
    </LocalizedText>
</Database>
